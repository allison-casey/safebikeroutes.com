{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "plugin",
          "theme",
          "utility",
          "source",
          "config"
        ]
      }
    ]
  }
}
